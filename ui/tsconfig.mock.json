{
  // Type-checking for mock-core/ (it runs in Node, not the browser).
  // Its own file because tsconfig.node.json uses "nodenext" imports, which
  // would demand ".ts" on every import, including the ones inside src/mock.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mock.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["mock-core"]
}
